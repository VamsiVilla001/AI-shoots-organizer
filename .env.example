# Optional override. By default SKWAD reads auth/credentials.json beneath its
# application data directory. Never commit a real credential file.
SKWAD_AUTH_FILE=D:\path\outside-the-repository\credentials.json

# Desktop public/runtime configuration. It talks only to the small SKWAD
# signing/rewrap service and must never receive backend private keys.
SKWAD_BACKEND_URL=http://127.0.0.1:8787
