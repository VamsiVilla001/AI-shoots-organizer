# Local Supabase (`supabase start` prints these values).
# For a permanent self-hosted/LAN deployment, replace these two public values;
# never put a service-role key or database password in the desktop environment.
SKWAD_SUPABASE_URL=http://127.0.0.1:54321
SKWAD_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Desktop public/runtime configuration. It talks only to the small SKWAD
# signing/rewrap service and must never receive backend private keys.
SKWAD_BACKEND_URL=http://127.0.0.1:8787
