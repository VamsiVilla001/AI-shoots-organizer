# Backend-only secret configuration. Generate with:
# cargo run -p skwad-backend -- keygen
# Never expose this environment to the desktop process or commit real values.
SKWAD_BACKEND_BIND=127.0.0.1:8787
SKWAD_BACKEND_AUTH_TOKEN=replace-with-at-least-24-random-characters
SKWAD_SIGNING_KEY_ID=local-signing-v1
SKWAD_SIGNING_PRIVATE_KEY=base64-without-padding
SKWAD_SIGNING_PUBLIC_KEY=base64-without-padding
SKWAD_WRAPPING_KEY_ID=local-wrapping-v1
SKWAD_WRAPPING_PRIVATE_KEY=base64-without-padding
SKWAD_WRAPPING_PUBLIC_KEY=base64-without-padding
