{
  "name": "skwad-media-organiser",
  "private": true,
  "version": "2.0.0-alpha.3",
  "description": "SKWAD Media Organiser — local-first player-wise sorting for esports photo and video shoots",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run tauri:dev -w @skwad/desktop",
    "db:setup": "node scripts/setup-postgres.mjs",
    "db:check": "node scripts/setup-postgres.mjs --check",
    "db:migrate": "cargo run --release -p skwad-database --features migrate-from-sqlite --bin skwad-db-migrate --",
    "db:verify": "cargo run -q -p skwad-database --example verify_migration --",
    "opencv:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-opencv.ps1",
    "package:premiere-panel": "node scripts/package-premiere-panel.mjs",
    "dev:opencv": "npm run opencv:setup && npm run tauri:dev -w @skwad/desktop -- -- --features opencv-tracking",
    "build": "npm run package:premiere-panel && npm run tauri:build -w @skwad/desktop",
    "build:opencv": "npm run package:premiere-panel && npm run opencv:setup && npm run tauri:build -w @skwad/desktop -- -- --features opencv-tracking",
    "web:dev": "npm run dev -w @skwad/desktop",
    "web:build": "npm run build -w @skwad/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "rs:check": "cargo check --workspace --all-targets",
    "rs:test": "cargo test --workspace",
    "rs:test:opencv": "cargo test -p skwad-video-analysis --features opencv-tracking",
    "rs:fmt": "cargo fmt --all",
    "rs:clippy": "cargo clippy --workspace --all-targets -- -D warnings"
  },
  "engines": {
    "node": ">=20"
  }
}
